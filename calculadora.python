num1 = float(input("Digite o primeiro numero: "))
operador = input("Digite a operacao (+, -, *, /): ")
num2 = float(input("Digite o segundo numero: "))

if operador == "+":
    resultado = num1 + num2
elif operador == "-":
    resultado = num1 - num2
elif operador == "*":
    resultado = num1 * num2
elif operador == "/":
    resultado = num1 / num2
else:
    print("Operacao invalida")
    resultado = None

if resultado != None:
    print("Resultado:", resultado)
